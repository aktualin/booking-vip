# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL=

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL=

# Cloudflare R2 (S3-compatible object storage)
# CLOUDFLARE_S3_API: S3 API endpoint used for signed server-side operations
#   (put/head/get) — the r2.cloudflarestorage.com host. A trailing /<bucket>
#   path is tolerated and ignored.
# CLOUDFLARE_S3_ENDPOINT: public base of the bucket — the custom domain (or
#   r2.dev subdomain) stored in DB image URLs and loaded directly by the
#   browser; next.config.ts allow-lists this host for next/image. Must NOT be
#   an r2.cloudflarestorage.com host. Leave unset to serve images through the
#   app's own /media/<key> proxy. Private documents (PII) always use the
#   proxy regardless of this setting.
# CLOUDFLARE_ACCESS_KEY_ID / CLOUDFLARE_ACCESS_SECRET: S3 credentials.
CLOUDFLARE_S3_API=
CLOUDFLARE_S3_ENDPOINT=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_ACCESS_SECRET=
# R2_BUCKET=vip-book
# PRIVATE_R2_BUCKET=   # bucket WITHOUT public access for PII (recommended in production)

# Firebase Admin SDK (server side only - never expose to the browser)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_ID=
# Keep the key on one line with escaped newlines (\n)
FIREBASE_PRIVATE_KEY=

# Firebase Web SDK config (server side usage only)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# Firebase Web SDK config (browser side - the API key is not a secret, but it
# is still tied to the project). Used by the customer login/register pages
# for the Google sign-in popup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Public base URL of the deployment (used for the password-reset redirect).
NEXT_PUBLIC_SITE_URL=
# Public HTTPS origin of this app — used for Xendit payment return URLs.
# Xendit rejects non-HTTPS URLs: local dev needs an HTTPS tunnel (ngrok/cloudflared).
NEXT_PUBLIC_APP_URL=

# Xendit payment gateway (Payments API v3) — Credit Card via hosted Payment Session.
# Secret API key (xnd_development_… / xnd_production_…) from the Xendit dashboard.
XENDIT_API_KEY=
# Webhook verification token (x-callback-token) configured in the Xendit dashboard.
XENDIT_WEBHOOK_VERIFICATION_TOKEN=
# Public key (xnd_public_…) — only needed for future client-side Components integration.
XENDIT_PUBLIC_KEY=
# Return URLs must be HTTPS — local development needs an HTTPS tunnel,
# e.g. https://<tunnel>/payment/return and https://<tunnel>/api/payments/webhook/xendit

# Booking confirmation notifier (WhatsApp via Twilio REST) — optional.
# When all three are set, a paid booking sends the customer a WhatsApp
# confirmation with the e-voucher link. When unset, the notification is
# skipped with a log line — payments are never blocked by it.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio WhatsApp sender, E.164 (e.g. +14155238886 for the sandbox).
TWILIO_WHATSAPP_FROM=

# Admin area (Firebase Auth, server-side only)
# ADMIN_ENABLED is a deployment kill-switch: 1 = admin area reachable.
ADMIN_ENABLED=0
# Comma-separated list of emails allowed to use /admin.
# This is only the bootstrap allowlist: the first time an allowlisted email
# signs in to /admin/login its Postgres `User.role` becomes ADMIN. After that
# the database is the source of truth — revoke access by setting
# `role = 'USER'` on the `User` row.
ADMIN_EMAILS=
