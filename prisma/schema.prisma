generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Akun pengguna — identitas berasal dari Firebase Auth (`id` = Firebase UID).
/// `role` adalah pembeda utama antara admin dan user biasa:
///   - "ADMIN" → hanya boleh masuk lewat `/admin`
///   - "USER"  → hanya boleh masuk lewat `/login` / `/register`
model User {
  id            String   @id
  email         String   @unique
  name          String?
  phone         String?
  /// "ADMIN" | "USER"
  role          String   @default("USER")
  emailVerified Boolean  @default(false)
  /// Loyalty points — the level is derived from the `LoyaltyLevel` table.
  points        Int      @default(0)
  levelId       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings      Booking[]
  savedCards    SavedCard[]
  reviews       Review[]
  level         LoyaltyLevel? @relation(fields: [levelId], references: [id])
  visaApplications VisaApplication[]
  pushSubscriptions PushSubscription[]
}

/// A loyalty tier — the thresholds live in the database, so they can be changed
/// without a deploy. `minPoints` is the number of points needed to reach the tier.
model LoyaltyLevel {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  minPoints   Int      @default(0)
  /// Points multiplier used when a booking is paid for.
  multiplier  Float    @default(1)
  /// ["Discount 5%", "Priority support"] — a free-form benefit list.
  benefits    Json     @default("[]")
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)

  users       User[]
}

/// A saved payment card. The number is **encrypted** (AES-256-GCM) — only the last
/// four digits are kept in clear. The CVV is never collected nor stored.
model SavedCard {
  id              String   @id @default(uuid())
  userId          String
  /// "visa" | "mastercard" | "jcb" | …
  brand           String   @default("card")
  /// The last four digits, in clear.
  last4           String
  /// The full card number, encrypted.
  encryptedNumber String
  expMonth        Int
  expYear         Int
  holderName      String?
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// A customer review (comment) on a product or a service line.
/// The replies form a parent → child → child tree through `parentId`.
model Review {
  id          String   @id @default(uuid())
  userId      String
  /// "product" | "serviceLine"
  subjectType String   @default("product")
  subjectId   String
  rating      Int      @default(5)
  body        String
  /// How many times the review was seen.
  views       Int      @default(0)
  /// How many likes it got.
  likes       Int      @default(0)
  /// The parent review when this is a reply.
  parentId    String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent      Review?  @relation("ReviewReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Review[] @relation("ReviewReplies")

  @@index([userId])
  @@index([subjectType, subjectId])
}

/// A visa application (the e-VOA service).
/// An e-VOA service order: we apply for the visa on behalf of the customer.
/// One order carries 1..5 applicants (VisaApplicant); travel plan and
/// accommodation are shared by the group, documents and visas are per person.
model VisaApplication {
  id             String   @id @default(uuid())
  /// A human readable application number.
  code           String   @unique
  userId         String?
  productId      String?
  /// Legacy single-applicant fields — kept for old rows; new orders store
  /// per-person data in VisaApplicant.
  fullName       String?
  passportNumber String?
  nationality    String?
  dateOfBirth    DateTime?
  arrivalDate    DateTime
  /// Contact email of the pemesan (the account holder).
  email          String
  phone          String
  /// "draft" | "awaiting_payment" | "paid" | "review" | "revision" |
  /// "processing" | "issued" | "completed" | "rejected" | "refunded" |
  /// "expired". Legacy rows may carry "submitted" | "approved".
  status         String   @default("submitted")
  note           String?
  totalUsdCents  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  /// The VIP booking this VOA handling belongs to (internal eVOA flow).
  bookingId      String?

  /// Name of the pemesan (may differ from every applicant).
  contactName    String?
  /// "tourism" | "family_social" | "government" | "business_meeting" |
  /// "goods_purchase" | "transit"
  purpose        String?
  flightNumber   String?
  /// The immigration checkpoint (TPI) of arrival — an Airport row.
  portOfEntryId  String?
  /// Snapshot of the checkpoint name at submission time.
  portOfEntryName String?
  departureDate  DateTime?
  departureFlightNumber String?
  hotelName      String?
  hotelAddress   String?
  hotelCity      String?
  hotelPostalCode String?
  /// Answers to admin-defined order-level fields (EvoaFormField scope
  /// "application") — { [fieldKey]: value }.
  extraAnswers   Json     @default("{}")
  /// The official portal transaction reference entered by ops.
  officialTransactionRef String?
  /// Order-level revision request note shown to the customer.
  revisionNote   String?
  paidAt         DateTime?
  processingAt   DateTime?
  completedAt    DateTime?

  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking        Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  portOfEntry    Airport? @relation(fields: [portOfEntryId], references: [id], onDelete: SetNull)
  applicants     VisaApplicant[]
  documents      VisaDocument[]
  events         EvoaStatusEvent[]

  @@index([userId])
  @@index([bookingId])
  @@index([status])
}

/// One person the e-VOA is applied for (1..5 per order).
model VisaApplicant {
  id             String   @id @default(uuid())
  applicationId  String
  sortOrder      Int      @default(0)
  /// Full name exactly as printed in the passport.
  fullName       String
  /// "male" | "female"
  gender         String
  dateOfBirth    DateTime
  placeOfBirth   String
  /// Country code (Country.code) of the nationality.
  nationality    String
  passportNumber String
  /// "ordinary" | "emergency" — emergency passports need 12 months validity.
  passportType   String   @default("ordinary")
  passportIssuingCountry String
  passportIssueDate DateTime?
  passportExpiryDate DateTime
  /// Email the issued e-VOA is delivered to.
  email          String
  phone          String
  /// Relationship to the pemesan: "self" | "family" | "client" | "other".
  relation       String   @default("other")
  /// Answers to admin-defined applicant-level fields — { [fieldKey]: value }.
  extraAnswers   Json     @default("{}")
  /// "pending" | "review" | "revision" | "processing" | "issued" | "rejected"
  status         String   @default("pending")
  visaNumber     String?
  /// R2 key of the issued e-VOA PDF (private — served via /media with auth).
  visaPdfKey     String?
  issuedAt       DateTime?
  visaExpiresAt  DateTime?
  revisionNote   String?
  createdAt      DateTime @default(now())

  application    VisaApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  documents      VisaDocument[]
  events         EvoaStatusEvent[]

  @@unique([applicationId, passportNumber])
  @@index([applicationId])
}

/// One uploaded file of an e-VOA order. Several rows may share a slot
/// (multiple files per document kind). Order-level files have no applicant.
model VisaDocument {
  id            String   @id @default(uuid())
  applicationId String
  /// Null for order-level documents (e.g. a sponsor letter).
  applicantId   String?
  /// "passport" | "photo" | "ticket" | "hotel" | an EvoaFormField key.
  slot          String
  /// The object key inside the bucket (server-generated UUID).
  key           String
  url           String
  fileName      String
  mimeType      String
  sizeBytes     Int
  sortOrder     Int      @default(0)
  /// "pending" | "ok" | "revision"
  reviewStatus  String   @default("pending")
  reviewNote    String?
  createdAt     DateTime @default(now())

  application   VisaApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicant     VisaApplicant?  @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([applicantId])
  @@index([key])
}

/// An admin-defined extra form field rendered on top of the standard e-VOA
/// form. Managed without a deploy from /admin/settings/evoa-fields.
model EvoaFormField {
  id            String   @id @default(uuid())
  /// Stable machine key — also the document slot for "file" fields.
  key           String   @unique
  labelEn       String
  labelId       String?
  /// "text" | "textarea" | "number" | "date" | "select" | "checkbox" | "file"
  type          String
  /// "application" (once per order) | "applicant" (once per person).
  scope         String   @default("applicant")
  required        Boolean  @default(false)
  /// Select options: [{ value, labelEn, labelId? }].
  options       Json     @default("[]")
  /// Conditional visibility: { field: "purpose" | "<fieldKey>", equals: "x" }.
  /// Null = always visible.
  showWhen      Json?
  placeholderEn String?
  placeholderId String?
  helpEn        String?
  helpId        String?
  /// File fields: how many files may be uploaded (null = 1).
  maxFiles      Int?
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

/// Append-only audit trail of an e-VOA order (and optionally one applicant).
model EvoaStatusEvent {
  id            String   @id @default(uuid())
  applicationId String
  applicantId   String?
  status        String
  note          String?
  /// "customer" | "admin" | "system"
  actor         String   @default("system")
  actorEmail    String?
  createdAt     DateTime @default(now())

  application   VisaApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicant     VisaApplicant?  @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([createdAt])
}

/// A promo code that cuts the price — either a fixed amount (USD cents) or a
/// percentage of the subtotal.
model PromoCode {
  id               String    @id @default(uuid())
  code             String    @unique
  title            String
  /// "fixed" | "percentage"
  type             String    @default("percentage")
  /// Fixed → USD cents. Percentage → 0-100.
  value            Int       @default(0)
  minTotalUsdCents Int       @default(0)
  usageLimit       Int?
  usedCount        Int       @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())

  @@index([active])
}

/// Searches submitted from the home page form.
/// Append-only history; `values` holds the entered form fields per service.
model SearchLog {
  id        String   @id @default(uuid())
  service   String
  href      String
  values    Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Top-level service line (VIP, Transport, Tour, eVOA).
model ServiceLine {
  id        String        @id @default(uuid())
  slug      String        @unique
  label     String
  short     String
  badge     String?
  tone      String
  /// Copy of the service page (hero intro + body sections).
  introEn   String?
  introId   String?
  /// [{ heading, body }]
  sections  Json          @default("[]")
  /// [{ heading, body }] — Indonesian copy.
  sectionsId Json         @default("[]")
  /// Short feature list shown next to the booking panel.
  highlights Json         @default("[]")
  /// Short feature list — Indonesian.
  highlightsId Json       @default("[]")
  /// Filter tabs of the line catalog.
  tabs      Json          @default("[]")
  /// Filter tabs — Indonesian.
  tabsId    Json          @default("[]")
  imageUrl  String?
  imageCredit String?
  sortOrder Int           @default(0)
  active    Boolean       @default(true)
  types     ServiceType[]
  products  Product[]
  priceTiers PriceTier[]
  promos    Promo[]
  searchFields SearchField[]
}

/// Sub-category within a line (e.g. Meet & Greet, Sedan, Tourist eVOA).
model ServiceType {
  id        String    @id @default(uuid())
  lineId    String
  slug      String
  name      String
  /// Indonesian name — null falls back to `name` (content_i18n convention).
  nameId    String?
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  line      ServiceLine @relation(fields: [lineId], references: [id])
  products  Product[]

  @@unique([lineId, slug])
}

/// Generic place reference (used by Products for geographic scope).
/// Places form a full parent → child hierarchy: a row may point at a parent
/// row through `parentId`. The tree is generic — any place may parent any
/// other place — and drives the grouped / cascading dropdowns.
///
/// `level` is the administrative depth of the row:
///   region → country → province → city → district → village
/// with leaf spots (`airport`, `area`, `destination`) hanging below the
/// administrative node they belong to. `kind` is kept for backward
/// compatibility and mirrors `level` for the administrative rows; the leaf
/// kinds (airport / area / destination) are unchanged.
model Airport {
  id          String    @id @default(uuid())
  /// "airport" | "city" | "area" | "destination" | "region" | "country" |
  /// "province" | "district" | "village"
  kind        String    @default("airport")
  /// Administrative level: "region" | "country" | "province" | "city" |
  /// "district" | "village" | "airport" | "area" | "destination".
  level       String    @default("city")
  iataCode    String?   @unique
  name        String
  /// Indonesian place name — null falls back to `name`.
  nameId      String?
  city        String
  /// Indonesian city label — null falls back to `city`.
  cityId      String?
  country     String    @default("Indonesia")
  imageUrl    String?
  imageCredit String?
  active      Boolean   @default(true)
  /// Optional parent place (self relation).
  parentId    String?
  parent      Airport?  @relation("PlaceHierarchy", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children    Airport[] @relation("PlaceHierarchy")
  /// Sort order inside the parent group (lower comes first).
  sortOrder   Int       @default(0)
  products    Product[]
  /// The tour products that use this place as their destination.
  destinations Product[] @relation("DestinationPlace")
  /// The e-VOA orders arriving through this checkpoint (TPI).
  visaApplications VisaApplication[]

  @@index([level])
  @@index([parentId])
}

/// A bookable product (VIP service, vehicle, tour package, eVOA plan).
/// `direction` allowed values: "arrival" | "departure" | "both"
/// `isAddOn`: true for add-on products that piggyback on other bookings.
model Product {
  id               String    @id @default(uuid())
  slug             String    @unique
  lineId           String
  serviceTypeId    String?
  airportId        String?
  title            String
  /// Indonesian title — null falls back to `title` (content_i18n convention).
  titleId          String?
  description      String    @default("")
  /// Indonesian description — null falls back to `description`.
  descriptionId    String?
  /// "arrival" | "departure" | "both"
  direction        String    @default("both")
  leadTimeHours    Int       @default(0)
  leadTimeDays     Int       @default(0)
  /// The transport vendor (the rental company / the tour operator).
  vendor           String?
  /// "manual" | "automatic"
  transmission     String?
  /// How many passengers the vehicle carries.
  seats            Int?
  /// How many units of this vehicle the vendor owns (rental stock). Available
  /// stock is derived from active bookings.
  stockTotal       Int       @default(1)
  /// "with_driver" | "without_driver"
  driverOption     String    @default("with_driver")
  /// "vendor_pickup" (free — pick up at the vendor) | "delivered" (extra fee).
  pickupPolicy     String?
  /// Tour only: "private" (per vehicle, flexible date) | "join_in"
  /// (per pax, scheduled departures with a seat quota). Null for non-tour lines.
  tourKind         String?
  /// Tour only: the number of days of an overnight package (0 = day tour).
  durationDays     Int       @default(0)
  /// Tour only: minimum paying passengers (adult + child) per booking.
  minPax           Int       @default(1)
  /// Tour only: maximum passengers per booking / unit (null = no limit).
  maxPax           Int?
  /// The tour destination — a place row of kind "destination".
  destinationId    String?
  /// The day-by-day itinerary of a tour package.
  itinerary        Json      @default("[]")
  /// Free-form key/value specs — [{ key, name }] (e.g. { key: "luggage",
  /// name: "2 koper" }). Rendered as the vehicle spec grid; `key` is the
  /// stable machine identifier, `name` the display text.
  specs            Json      @default("[]")
  included         Json      @default("[]")
  /// Indonesian included list — null falls back to `included`.
  includedId       Json?
  notIncluded      Json      @default("[]")
  /// Indonesian not-included list — null falls back to `notIncluded`.
  notIncludedId    Json?
  requirements     Json      @default("[]")
  /// Indonesian requirements list — null falls back to `requirements`.
  requirementsId   Json?
  isAddOn          Boolean   @default(false)
  imageUrl         String?
  imageCredit      String?
  tone             String    @default("from-sky-400 to-blue-600")
  ribbon           String?
  /// Indonesian ribbon — null falls back to `ribbon`.
  ribbonId         String?
  rating           Float?
  reviews          Int?
  durationLabel    String?
  /// Indonesian duration label — null falls back to `durationLabel`.
  durationLabelId  String?
  fromPriceUsdCents Int?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  line             ServiceLine   @relation(fields: [lineId], references: [id])
  serviceType      ServiceType?  @relation(fields: [serviceTypeId], references: [id])
  airport          Airport?      @relation(fields: [airportId], references: [id])
  destination      Airport?      @relation("DestinationPlace", fields: [destinationId], references: [id])
  packages         ProductPackage[]
  /// Add-ons this product offers (where this product is the host).
  hostAddOns       ProductAddOn[] @relation("HostAddOns")
  /// Add-ons where this product is the offered add-on itself.
  addOnOffers      ProductAddOn[] @relation("AddOnOffers")
  amenities        ProductAmenity[]
  bookingItems     BookingItem[]
  bookingAddOns    BookingAddOn[]
  /// The scheduled join-in departures of this tour product.
  departures       TourDeparture[]

  @@index([lineId])
}

/// A purchasable package/variant of a Product (e.g. Standard per-pax tier, or a 6hr/10hr hourly hire).
/// `unitKind` allowed values: "per_pax" | "per_unit"
model ProductPackage {
  id              String    @id @default(uuid())
  productId       String
  label           String
  /// Indonesian label — null falls back to `label` (content_i18n convention).
  labelId         String?
  /// "per_pax" | "per_unit"
  unitKind        String    @default("per_pax")
  adultUsdCents   Int?
  childUsdCents   Int?
  infantUsdCents  Int?      @default(0)
  unitUsdCents    Int?
  durationHours   Int?
  extraHourUsdCents Int?
  /// The strikethrough "from" price (USD cents) — shown when a promo cuts
  /// the package price. Null means no promo.
  fromUsdCents    Int?
  /// Short package description shown on the selectable package card.
  description     String?
  /// Indonesian package description — null falls back to `description`.
  descriptionId   String?
  /// Free-form key/value info — [{ key, name, excluded? }]. Entries with
  /// `excluded: true` are costs the customer pays to the vendor directly
  /// (fuel, driver meals, …) and feed the pink excluded-costs banner.
  info            Json      @default("[]")
  sortOrder       Int       @default(0)
  active          Boolean   @default(true)
  product         Product   @relation(fields: [productId], references: [id])
  bookingItems    BookingItem[]
}

/// Price band used for UI filtering of catalog results per line.
model PriceTier {
  id          String      @id @default(uuid())
  lineId      String?
  label       String
  maxUsdCents Int
  sortOrder   Int         @default(0)
  active      Boolean     @default(true)
  line        ServiceLine? @relation(fields: [lineId], references: [id])
}

/// An amenity (e.g. "With Driver", "AC"). Join table `ProductAmenity`.
model Amenity {
  id       String           @id @default(uuid())
  label    String           @unique
  products ProductAmenity[]
}

model ProductAmenity {
  id        String  @id @default(uuid())
  productId String
  amenityId String
  product   Product @relation(fields: [productId], references: [id])
  amenity   Amenity @relation(fields: [amenityId], references: [id])

  @@unique([productId, amenityId])
}

/// Directed edge: product (host) offers product (addOn).
model ProductAddOn {
  id        String  @id @default(uuid())
  productId String
  addOnId   String
  sortOrder Int     @default(0)
  product   Product @relation("HostAddOns", fields: [productId], references: [id])
  addOn     Product @relation("AddOnOffers", fields: [addOnId], references: [id])

  @@unique([productId, addOnId])
}

/// A customer booking (one per checkout wizard).
/// `status` allowed values: "awaiting_payment" | "confirmed" | "cancelled" | "completed"
model Booking {
  id              String    @id @default(uuid())
  code            String    @unique
  /// "awaiting_payment" | "confirmed" | "cancelled" | "completed"
  status          String    @default("awaiting_payment")
  serviceAt       DateTime
  adultCount      Int       @default(1)
  childCount      Int       @default(0)
  infantCount     Int       @default(0)
  /// How many units of the vehicle this booking reserves (transport rentals).
  vehicleCount    Int       @default(1)
  subtotalUsdCents Int
  addOnsUsdCents  Int       @default(0)
  totalUsdCents   Int
  /// Firebase UID of the signed-in user (null for guest bookings).
  userId          String?
  /// The invoice number — `#INV/YYYY/MM/DD/4DIGIT/2RANDOM`.
  invoiceNumber   String?   @unique
  /// Client-generated key deduping booking creation — a retry with the same
  /// key returns the original booking.
  idempotencyKey  String?   @unique
  /// The promo code that was applied.
  promoCode       String?
  /// The discount that was applied (USD cents).
  discountUsdCents Int      @default(0)
  /// The tax lines that were applied — [{ key, label, value }].
  taxes           Json      @default("[]")
  taxUsdCents     Int       @default(0)
  /// The pickup point of a transport booking (address + coordinates).
  pickupLabel     String?
  pickupLat       Float?
  pickupLng       Float?
  /// The dropoff point of a transport booking (address + coordinates).
  dropoffLabel    String?
  dropoffLat      Float?
  dropoffLng      Float?
  /// A free-form note from the customer (the "special request").
  notes           String?
  /// Operational status of the VIP service — separate from the payment
  /// `status`: "waiting_documents" | "processing" | "ready" | "in_service" | "done"
  opsStatus       String    @default("waiting_documents")
  /// The greeter assigned to meet the traveller at the airport.
  greeterName     String?
  greeterPhone    String?
  /// Internal operator note about the service handling.
  opsNote         String?
  /// "with_driver" | "without_driver"
  driverOption    String?
  /// "vendor_pickup" | "delivered"
  pickupPolicy    String?
  /// Tour: the scheduled join-in departure this booking seats on.
  departureId     String?
  /// Tour: the driver assigned by the operator (roster).
  driverId        String?
  /// Tour: the vehicle assigned by the operator (roster).
  vehicleId       String?
  /// Tour: the hotel / pickup point name the customer typed.
  hotelName       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contact         Contact?
  flight          FlightDetails?
  travelers       Traveler[]
  items           BookingItem[]
  addOns          BookingAddOn[]
  payments        Payment[]
  visaApplications VisaApplication[]
  signedContract  SignedContract?
  user            User?     @relation(fields: [userId], references: [id])
  departure       TourDeparture? @relation(fields: [departureId], references: [id], onDelete: SetNull)
  driver          Driver?        @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle         Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([departureId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([status, serviceAt])
}

model BookingItem {
  id            String   @id @default(uuid())
  bookingId     String
  productId     String
  packageId     String?
  label         String
  packageLabel  String?
  /// "per_pax" | "per_unit" | "per_day"
  unitKind      String
  adultCount    Int      @default(0)
  childCount    Int      @default(0)
  infantCount   Int      @default(0)
  /// How many units were booked — the number of rental days for "per_day".
  quantity      Int      @default(1)
  /// How many units of this vehicle this line reserves (transport rentals).
  vehicleCount  Int      @default(1)
  unitUsdCents  Int
  totalUsdCents Int
  booking       Booking  @relation(fields: [bookingId], references: [id])
  product       Product  @relation(fields: [productId], references: [id])
  package       ProductPackage? @relation(fields: [packageId], references: [id])
}

model BookingAddOn {
  id             String  @id @default(uuid())
  bookingId      String
  addOnProductId String
  label          String
  quantity       Int     @default(1)
  unitUsdCents   Int
  totalUsdCents  Int
  booking        Booking @relation(fields: [bookingId], references: [id])
  addOnProduct   Product @relation(fields: [addOnProductId], references: [id])
}

model Contact {
  id              String  @id @default(uuid())
  bookingId       String  @unique
  /// "mr" | "mrs" | "ms"
  title           String?
  firstName       String
  lastName        String
  email           String
  phoneCountryCode String
  phone           String
  isGuestSelf     Boolean @default(true)
  /// The traveller's country of origin (name from the `Country` table) —
  /// drives which paperwork the greeter prepares (e.g. Visa on Arrival).
  nationality     String?
  notes           String?
  /// Renter identity number: NIK / SSN / passport number.
  identityNumber  String?
  /// "ktp" | "ssn" | "passport"
  idType          String?
  /// Stored URL of the uploaded ID document (image/PDF).
  idDocumentUrl   String?
  /// Stored URL of the renter signature PNG.
  signatureUrl    String?
  booking         Booking @relation(fields: [bookingId], references: [id])
}

model Traveler {
  id        String  @id @default(uuid())
  bookingId String
  fullName  String
  /// "adult" | "child" | "infant"
  kind      String
  sortOrder Int
  /// Passport number, as printed in the travel document.
  passportNumber String?
  /// Nationality (country name from the `Country` table).
  nationality    String?
  dateOfBirth    DateTime?
  /// Must be at least 6 months after the service date (immigration rule).
  passportExpiry DateTime?
  /// PRIVATE R2 object key of the passport photo — never a public URL;
  /// the admin reads it through a signed URL.
  passportPhotoKey String?
  /// Document handling status:
  /// "pending" | "received" | "processing" | "ready" | "issue"
  docStatus String @default("pending")
  /// Operator note about this traveller's documents.
  docNote   String?
  booking   Booking @relation(fields: [bookingId], references: [id])
}

model FlightDetails {
  id           String  @id @default(uuid())
  bookingId    String  @unique
  /// "arrival" | "departure"
  airportName  String?
  location     String?
  airline      String?
  flightCode   String?
  /// "arrival" | "departure"
  direction    String?
  booking      Booking @relation(fields: [bookingId], references: [id])
}

/// A scheduled join-in tour departure.
///
/// Seats are derived — never stored — from the bookings that actively
/// reserve them (the same pattern as the transport rental stock):
///   - every "confirmed" booking reserves its adult + child count, always;
///   - an "awaiting_payment" booking reserves for 24 hours after creation,
///     then lazily expires (no cron);
///   - "completed" and "cancelled" bookings reserve nothing.
/// Infants do not occupy a seat.
model TourDeparture {
  id        String   @id @default(uuid())
  productId String
  /// The calendar date of the departure (stored at midnight).
  date      DateTime
  /// Local start time, "HH:MM" (e.g. "08:00").
  startTime String   @default("08:00")
  /// Total seats sold on this departure.
  quota     Int      @default(10)
  /// "open" | "closed" | "cancelled"
  status    String   @default("open")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([productId, date])
}

/// A tour driver / guide — the operator roster.
model Driver {
  id        String   @id @default(uuid())
  name      String
  /// WhatsApp number in international format, e.g. "6281234567890".
  phone     String
  /// Languages spoken — free form, e.g. "EN, ID".
  languages String?
  photoUrl  String?
  notes     String?
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]
}

/// A tour vehicle — the operator roster.
model Vehicle {
  id          String   @id @default(uuid())
  /// e.g. "Toyota Innova Reborn".
  name        String
  plateNumber String?
  seats       Int      @default(6)
  photoUrl    String?
  notes       String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings Booking[]
}

model PaymentMethod {
  id        String    @id @default(uuid())
  code      String    @unique
  label     String
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  /// The gateway that settles this method: "xendit" | null (offline).
  provider  String?
  /// The method code as the gateway names it ("CREDIT_CARD").
  providerMethodCode String?
  payments  Payment[]
}

model Payment {
  id             String   @id @default(uuid())
  bookingId      String
  methodId       String?
  /// "pending" | "paid" | "failed" | "refunded"
  status         String   @default("pending")
  amountUsdCents Int
  reference      String?
  /// The gateway that owns this payment: "xendit" | null.
  provider       String?
  /// The provider-side id (the Xendit payment session id).
  providerRef    String?
  /// The amount charged by the provider, in the provider currency's cents
  /// (IDR has no decimals, so this is the whole-rupiah amount × 100).
  providerAmountCents Int?
  /// The currency the customer was charged in: "IDR".
  providerCurrency String?
  /// The USD→provider-currency rate frozen at payment creation.
  fxRate         Float    @default(1)
  /// The checkout URL the customer was redirected to.
  checkoutUrl    String?
  expiresAt      DateTime?
  paidAt         DateTime?
  /// The raw provider payload, kept for auditing.
  rawPayload     Json?
  createdAt      DateTime @default(now())
  booking        Booking  @relation(fields: [bookingId], references: [id])
  method         PaymentMethod? @relation(fields: [methodId], references: [id])

  @@index([providerRef])
}

/// A webhook event received from a gateway — the dedupe/audit ledger.
model PaymentWebhookEvent {
  id           String   @id @default(uuid())
  /// The gateway: "xendit".
  provider     String
  /// The provider's event id — unique per provider, so a replay is ignored.
  providerEventId String
  /// The event type, e.g. "invoice.paid".
  eventType    String
  /// "processed" | "ignored" | "failed".
  outcome      String   @default("processed")
  /// The raw payload as received.
  payload      Json?
  receivedAt   DateTime @default(now())

  @@unique([provider, providerEventId])
}

/// One article of the transport rental agreement ("pasal").
///
/// The content is authored by the operator in the admin area — in English,
/// because the agreement is signed as an English contract — and rendered
/// as-is on the booking wizard's agreement step. `sortOrder` drives the
/// article numbering (1 → "Article 1").
model ContractClause {
  id        String   @id @default(uuid())
  /// The article heading, e.g. "Renter Documents".
  title     String
  /// The article body — may carry several paragraphs separated by newlines.
  body      String
  /// Inactive articles are hidden from the agreement step.
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

/// The signed rental agreement of one transport booking.
///
/// `clausesSnapshot` freezes the articles as they were when the renter
/// signed, so later admin edits never rewrite a signed contract. The
/// signature image itself lives in the object storage (the same upload
/// endpoint the wizard's signature pad uses); `signatureUrl` points at it.
model SignedContract {
  id              String   @id @default(uuid())
  bookingId       String   @unique
  /// The articles as signed — [{ id, title, body, sortOrder }].
  clausesSnapshot Json
  /// The full name the renter typed under the signature.
  signerName      String
  /// Stored URL of the signature image (PNG).
  signatureUrl    String
  signedAt        DateTime @default(now())

  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([signedAt])
}

/// A browser push subscription (Web Push / VAPID).
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  /// The push service endpoint — unique per browser profile.
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Airline {
  id     String  @id @default(uuid())
  code   String  @unique
  name   String
  active Boolean @default(true)
}

model Country {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  dialCode String
  active   Boolean @default(true)
  /// Whether citizens of this country may get an Indonesian Visa on Arrival —
  /// the VIP wizard uses it to tell the traveller which paperwork we handle.
  voaEligible Boolean @default(true)
}

/// A file stored in Cloudflare R2 (S3-compatible object storage).
///
/// One row per object. `ownerType`/`ownerId` point at the content the file
/// belongs to, so a single content row can carry several images (a gallery).
model Media {
  id         String   @id @default(uuid())
  /// The content model that owns the file — "Product", "Airport", "Banner",
  /// "Promo", "Article", "Destination" or "ServiceLine".
  ownerType  String
  /// The id of the owning row.
  ownerId    String
  /// The object key inside the bucket, e.g. "products/meet-greet.jpg".
  key        String
  /// The URL the browser loads. Either the public R2/CDN URL or the app's
  /// own `/media/<key>` proxy — both are stable, never signed.
  url        String
  /// Alternative text for the image.
  alt        String?
  /// Attribution line — author + licence + source page.
  credit     String?
  /// Pixel size, so the layout does not shift while the image loads.
  width      Int?
  height     Int?
  /// Position of the file inside its gallery.
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([ownerType, ownerId])
  @@index([key])
}

/// A promo card on the home page.
model Promo {
  id          String  @id @default(uuid())
  slug        String  @unique
  titleEn     String
  titleId     String?
  subtitleEn  String?
  subtitleId  String?
  imageUrl    String?
  imageCredit String?
  tone        String  @default("from-blue-500 to-indigo-700")
  lineId      String?
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
  line        ServiceLine? @relation(fields: [lineId], references: [id])
}

/// A full-width promotional strip.
model Banner {
  id          String  @id @default(uuid())
  slug        String  @unique
  titleEn     String
  titleId     String?
  subtitleEn  String?
  subtitleId  String?
  ctaEn       String?
  ctaId       String?
  ctaHref     String?
  /// Where the banner is shown, e.g. "home".
  placement   String  @default("home")
  imageUrl    String?
  imageCredit String?
  tone        String  @default("from-blue-600 to-indigo-800")
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
}

/// A travel guide / article.
model Article {
  id          String  @id @default(uuid())
  slug        String  @unique
  titleEn     String
  titleId     String?
  categoryEn  String?
  categoryId  String?
  excerptEn   String?
  excerptId   String?
  imageUrl    String?
  imageCredit String?
  tone        String  @default("from-sky-400 to-blue-600")
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
}

/// A destination tile on the home page.
model Destination {
  id          String  @id @default(uuid())
  slug        String  @unique
  nameEn      String
  nameId      String?
  countryEn   String?
  countryId   String?
  imageUrl    String?
  imageCredit String?
  tone        String  @default("from-rose-400 to-red-600")
  sortOrder   Int     @default(0)
  active      Boolean @default(true)
}

/// A link in one of the home SEO link grids.
model SeoLink {
  id        String  @id @default(uuid())
  slug      String  @unique
  labelEn   String
  labelId   String?
  href      String
  /// The service this link points at ("Airport VIP Service", "Transport", …).
  service   String?
  /// "recommendations" | "services"
  group     String  @default("recommendations")
  /// Extra filter keys (e.g. a destination).
  tags      Json    @default("[]")
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

/// A block of SEO copy on the home page.
model SeoBlock {
  id        String  @id @default(uuid())
  slug      String  @unique
  titleEn   String
  titleId   String?
  /// [{ heading, body }]
  sections  Json    @default("[]")
  /// [{ heading, body }] — Indonesian copy.
  sectionsId Json   @default("[]")
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

/// A field of the home search form, scoped to a service line.
model SearchField {
  id            String  @id @default(uuid())
  lineId        String
  key           String
  labelEn       String
  labelId       String?
  placeholderEn String?
  placeholderId String?
  /// Icon slot: "plane" | "pin" | "cal" | "users" | "star"
  icon          String  @default("pin")
  /// Field kind — decides how the field renders.
  kind          String  @default("text")
  sortOrder     Int     @default(0)
  active        Boolean @default(true)
  line          ServiceLine @relation(fields: [lineId], references: [id])

  @@unique([lineId, key])
}

/// A key/value setting — hero copy, footer, tabs, quick time slots, …
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
